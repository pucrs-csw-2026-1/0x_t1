meta {
  name: 18 Admin Promote Demo User (200)
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/admin/users/{{demo_user_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{seed_admin_access_token}}
}

body:json {
  {
    "access_level": ["{{user_uuid}}", "{{admin_uuid}}"]
  }
}

assert {
  res.status: eq 200
  res.body.id: eq {{demo_user_id}}
}

tests {
  test("US-18: promocao adiciona admin sem perder user", function() {
    expect(res.body.access_level).to.include(bru.getVar("admin_uuid"));
    expect(res.body.access_level).to.include(bru.getVar("user_uuid"));
  });
}

docs {
  Capitulo 4 - US-18 admin promove demo_user a admin via PATCH.
  Note que o JWT atual de demo (demo_access_token) AINDA tem
  scopes=["user"] - escopos so sao re-emitidos em logins novos
  pos-promocao. Por isso o request 15 ja capturou o 403 antes
  desta promocao.
}
