meta {
  name: 18 Admin Promote Demo User (200)
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/admin/users/{{demo_user_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{seed_admin_access_token}}
}

body:json {
  {
    "access_level": "ADMIN"
  }
}

assert {
  res.status: eq 200
  res.body.id: eq {{demo_user_id}}
}

tests {
  test("US-27: promocao define o papel ADMIN", function() {
    expect(res.body.access_level).to.equal("ADMIN");
  });
}

docs {
  Capitulo 4 - US-18 admin promove demo_user a ADMIN via PATCH.
  Note que o JWT atual de demo (demo_access_token) AINDA tem apenas
  scopes=["participant"] - escopos so sao re-emitidos em logins novos
  pos-promocao. Por isso o request 15 ja capturou o 403 antes
  desta promocao.
}
