meta {
  name: 10 Change Password (204)
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{demo_access_token}}
}

body:json {
  {
    "current_password": "{{demo_password}}",
    "new_password": "NovaSenha@456"
  }
}

assert {
  res.status: eq 204
}

docs {
  Capitulo 3 - Troca de senha (US-16 PUT /users/me/password).
  Defesa em profundidade: exige a senha atual mesmo com token
  valido. O request 11 restaura a senha original para nao quebrar
  os logins seguintes do flow.
}
