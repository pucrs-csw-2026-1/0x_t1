meta {
  name: 11 Restore Password (204)
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{demo_access_token}}
}

body:json {
  {
    "current_password": "NovaSenha@456",
    "new_password": "{{demo_password}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Capitulo 3 - Restaura demo_password para nao quebrar o
  request 22 (login pos-deactivate, que tenta validar a senha).
}
