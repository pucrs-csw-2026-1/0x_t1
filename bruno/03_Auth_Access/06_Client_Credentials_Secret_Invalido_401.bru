meta {
  name: 06 Client Credentials Secret Invalido (401)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: metrics-service
  client_secret: secret-errado
}

assert {
  res.status: eq 401
}

docs {
  US-28 p2: client_secret incorreto (ou client_id desconhecido) retorna
  401 com o mesmo erro generico (nao vaza qual cliente existe).
}
