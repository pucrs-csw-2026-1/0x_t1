meta {
  name: 01 Register Auto Promocao Descartada 201
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/register
  body: json
  auth: none
}

body:json {
  {
    "first_name": "Auto",
    "last_name": "Promotor",
    "username": "auto.promotor",
    "email": "auto.promotor@example.com",
    "password": "Senha@123",
    "access_level": "ADMIN"
  }
}

assert {
  res.status: eq 201
  res.body.email: eq auto.promotor@example.com
  res.body.access_level: eq PARTICIPANT
}

tests {
  test("US-27: tentativa de auto-promocao a admin eh silenciosamente descartada", function() {
    expect(res.body.access_level).to.equal("PARTICIPANT");
  });
}

docs {
  Critério US-27: o cadastro público nunca concede papel elevado.
  Mesmo enviando `access_level: "ADMIN"` no body, o campo nem existe em
  UserCreate (e ignorado) e o usuário sai como PARTICIPANT — descarte
  silencioso (sem 422).
}
