meta {
  name: 05 Client Credentials Token (200)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: metrics-service
  client_secret: dev-metrics-secret
}

assert {
  res.status: eq 200
  res.body.token_type: eq bearer
  res.body.access_token: isDefined
}

tests {
  test("US-28 p2: client_credentials emite token de servico (sem refresh)", function() {
    expect(res.body).to.not.have.property("refresh_token");
  });
}

docs {
  OAuth2 client_credentials: um servico (maquina) autentica com
  client_id/client_secret e recebe um token com principal_type=service.
  Credenciais default de dev: metrics-service / dev-metrics-secret.
}
