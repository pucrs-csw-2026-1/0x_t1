meta {
  name: 01 Register email duplicado (409)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/register
  body: json
  auth: none
}

body:json {
  {
    "first_name": "{{first_name}}",
    "last_name": "{{last_name}}",
    "username": "{{username}}",
    "email": "{{email}}",
    "password": "{{password}}",
    "access_level": ["user"]
  }
}

docs {
  Pre-condicao: rodar 01_Happy_Path/01_Register antes (precisa do email
  ja cadastrado para gerar 409).
}

assert {
  res.status: eq 409
  res.body.detail: contains {{email}}
}
