meta {
  name: 02 Admin Get User (200)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/users/{{target_user_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_access_token}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{target_user_id}}
  res.body.email: eq alvo.admin@example.com
}

tests {
  test("US-18: senha nunca eh exposta no GET admin", function() {
    expect(res.body).to.not.have.property("password");
    expect(res.body).to.not.have.property("hashed_password");
  });
}

docs {
  Pre-requisitos: {{admin_access_token}} populado (vide setup admin
  no README) e request 01 desta pasta executado para popular
  {{target_user_id}}.
}
