meta {
  name: 04 Admin Get User Token User (403)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/admin/users/{{target_user_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

assert {
  res.status: eq 403
}

docs {
