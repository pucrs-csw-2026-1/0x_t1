meta {
  name: 05 Admin Update User (200)
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/admin/users/{{target_user_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_access_token}}
}

body:json {
  {
    "access_level": "ADMIN"
  }
}

assert {
  res.status: eq 200
  res.body.id: eq {{target_user_id}}
}

tests {
  test("US-27: PATCH retorna o papel atualizado (ADMIN)", function() {
    expect(res.body.access_level).to.equal("ADMIN");
  });
}

docs {
  Promove o usuario alvo a admin via API (substitui o passo manual
  de update-item no DDB documentado em 03_Auth_Access/04). Com a US-27
  o papel e um enum unico (string), nao mais lista de UUIDs.
}
