meta {
  name: 07 Admin Update Access Level Invalido (422)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/admin/users/{{target_user_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_access_token}}
}

body:json {
  {
    "access_level": "SUPERADMIN"
  }
}

assert {
  res.status: eq 422
}

docs {
  US-27: access_level e um enum (PARTICIPANT/MANAGER/ADMIN). Valor fora
  do enum e rejeitado pela validacao do Pydantic -> 422.
}
