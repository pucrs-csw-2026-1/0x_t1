meta {
  name: 01 Change Password (204)
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "current_password": "{{password}}",
    "new_password": "NovaSenha@123"
  }
}

assert {
  res.status: eq 204
}

docs {
  Troca a senha de Senha@123 para NovaSenha@123. O proximo request
  (02_Restore_Password) volta para a senha original — manter os dois
  em sequencia mantem a env consistente para os demais testes
  (login, refresh, etc).
}
