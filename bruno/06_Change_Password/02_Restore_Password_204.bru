meta {
  name: 02 Restore Password (204)
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "current_password": "NovaSenha@123",
    "new_password": "{{password}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Restaura a senha original ({{password}} = Senha@123) para nao
  quebrar logins/refreshes dos demais cenarios. Pre-condicao:
  request 01 executado com sucesso.
}
