meta {
  name: 01 Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/register
  body: json
  auth: none
}

body:json {
  {
    "first_name": "{{first_name}}",
    "last_name": "{{last_name}}",
    "username": "{{username}}",
    "email": "{{email}}",
    "password": "{{password}}",
    "age": 30,
    "area": "Engenharia",
    "gender": "OUTRO",
    "city": "Porto Alegre"
  }
}

assert {
  res.status: eq 201
  res.body.email: eq {{email}}
  res.body.username: eq {{username}}
  res.body.is_active: eq true
  res.body.access_level: eq PARTICIPANT
  res.body.age: eq 30
  res.body.area: eq Engenharia
  res.body.gender: eq OUTRO
  res.body.city: eq Porto Alegre
}

tests {
  test("US-26: cadastro persiste os campos demográficos", function() {
    expect(res.body.age).to.equal(30);
    expect(res.body.gender).to.equal("OUTRO");
  });
  test("US-27: cadastro público sempre cria PARTICIPANT", function() {
    expect(res.body.access_level).to.equal("PARTICIPANT");
  });
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("user_id", res.body.id);
  }
}
