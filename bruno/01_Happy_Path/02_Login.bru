meta {
  name: 02 Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{email}}
  password: {{password}}
}

assert {
  res.status: eq 200
  res.body.token_type: eq bearer
  res.body.access_token: isDefined
  res.body.refresh_token: isDefined
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("access_token", res.body.access_token);
    bru.setVar("refresh_token", res.body.refresh_token);
  }
}
