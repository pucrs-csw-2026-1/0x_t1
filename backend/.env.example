APP_ENV=development
# Não mais usado (a assinatura migrou de HS256 para RS256 na US-28); mantido
# por compatibilidade. Pode ser removido.
SECRET_KEY=changeme
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# RS256 (US-28): par de chaves para assinar/validar os JWTs. Em dev, os
# defaults apontam para o par versionado em backend/keys/ (dev-only). Em
# produção, sobrescreva apontando para chaves montadas de um cofre de
# segredos (AWS Secrets Manager — ver US-23); nunca commite a chave de prod.
RSA_PRIVATE_KEY_PATH=keys/dev_private.pem
RSA_PUBLIC_KEY_PATH=keys/dev_public.pem
JWT_KID=auth-dev-key

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

DYNAMODB_TABLE_USERS=user

# Cliente de serviço (OAuth2 client_credentials — US-28 parte 2).
# Em dev, um cliente seedado por config. Em prod, sobrescreva via cofre.
SERVICE_CLIENT_ID=metrics-service
SERVICE_CLIENT_SECRET=dev-metrics-secret
SERVICE_CLIENT_SCOPES=metrics:read